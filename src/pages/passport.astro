---
import Layout from '../layouts/Layout.astro';
import { FileCheck, ArrowLeft, Check } from 'lucide-react';
---

<Layout
  title="Biometric Passport & Visa Photo Module — Facesome.com"
  description="Global passport and visa photo compliance with ICAO standards, shadow removal, and 4x6 print sheets."
>
  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full flex flex-col items-center justify-center text-center">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-xs text-zinc-400 hover:text-white mb-8 transition-colors"
    >
      <ArrowLeft className="h-4 w-4" />
      <span>Back to Atelier</span>
    </a>

    <div class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs text-emerald-300 mb-6">
      <FileCheck className="h-3.5 w-3.5" />
      <span>Module Phase 2: In Private Beta</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-serif font-bold text-white tracking-tight">
      Global Passport & Visa Compliance
    </h1>

    <p class="mt-4 max-w-xl text-sm sm:text-base text-zinc-400 leading-relaxed font-light">
      Powered by open-source biometric standards. Guaranteed acceptance for US Passports, Schengen Visas, UK, Canada, and 130+ governments. Automatic shadow removal and 4x6 print sheet generation.
    </p>

    <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 w-full max-w-2xl text-left">
      <div class="glass-panel p-4 rounded-xl border border-white/10">
        <div class="flex items-center gap-1.5 text-xs font-semibold text-white">
          <Check className="h-4 w-4 text-emerald-400" />
          <span>ICAO 9303 Compliant</span>
        </div>
        <p class="text-[11px] text-zinc-400 mt-1">Biometric distance and ratio precision</p>
      </div>

      <div class="glass-panel p-4 rounded-xl border border-white/10">
        <div class="flex items-center gap-1.5 text-xs font-semibold text-white">
          <Check className="h-4 w-4 text-emerald-400" />
          <span>Universal Backgrounds</span>
        </div>
        <p class="text-[11px] text-zinc-400 mt-1">Pure white, light grey, or off-white</p>
      </div>

      <div class="glass-panel p-4 rounded-xl border border-white/10">
        <div class="flex items-center gap-1.5 text-xs font-semibold text-white">
          <Check className="h-4 w-4 text-emerald-400" />
          <span>Print-Ready 4x6 Sheet</span>
        </div>
        <p class="text-[11px] text-zinc-400 mt-1">Print at CVS or Walgreens for $0.39</p>
      </div>
    </div>

    <div class="mt-10 rounded-2xl glass-panel p-6 border border-white/15 w-full max-w-md">
      <h3 class="text-sm font-semibold text-white">
        Get Early Access & 15 Free Credits
      </h3>
      <p class="text-xs text-zinc-400 mt-1">
        We will notify you the moment this module opens to the public.
      </p>
      <form class="mt-4 flex gap-2" onsubmit="event.preventDefault(); alert('Thank you! You are on the private beta list.');">
        <input
          type="email"
          required
          placeholder="Enter your email"
          class="flex-1 rounded-xl bg-black/60 border border-white/15 px-3.5 py-2 text-xs text-white placeholder:text-zinc-600 outline-none focus:border-amber-400"
        />
        <button
          type="submit"
          class="rounded-xl bg-gradient-to-r from-[#dfb86c] to-[#c7983c] px-4 py-2 text-xs font-semibold text-black hover:scale-[1.02] transition-all"
        >
          Join Waitlist
        </button>
      </form>
    </div>
  </div>
</Layout>
