{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facesome",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".next",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "facesome-db",
      "database_id": "33f9721f-08da-4d5c-8d60-077371b2db73"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PORTRAITS_BUCKET",
      "bucket_name": "facesome-portraits"
    }
  ]
}
