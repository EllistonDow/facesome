# ==========================================
# Facesome Studio - Environment Variables
# ==========================================

# 1. Base URL
NEXT_PUBLIC_APP_URL=https://facesome.com

# 2. AI Inference Engine (Fal.ai for InstantID & Flux Portrait models)
# Get your key at https://fal.ai
FAL_KEY=your_fal_api_key_here

# 3. Cloudflare Edge Infrastructure (D1 & R2 via cf cli)
# Zero-egress storage & edge database provisioned via `cf`
CLOUDFLARE_ACCOUNT_ID=3c79e6ae374b917afed4a7aa8625b8d4
CLOUDFLARE_D1_DATABASE_ID=33f9721f-08da-4d5c-8d60-077371b2db73
CLOUDFLARE_R2_BUCKET_NAME=facesome-portraits

# Optional fallback: Supabase Auth & PostgreSQL
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 4. Payments (Lemon Squeezy or Stripe)
# For Lemon Squeezy (Recommended for Merchant of Record / Global Tax handling):
LEMONSQUEEZY_API_KEY=your_lemon_squeezy_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# Alternatively for Stripe:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
