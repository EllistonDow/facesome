---
import Layout from '../layouts/Layout.astro';
import { Flame, ArrowLeft, Check } from 'lucide-react';
---

<Layout
  title="Aesthetic Architecture & Style Diagnosis — Facesome.com"
  description="Facial ratio scan, haircut simulations, and aesthetic harmony blueprints."
>
  <div class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full flex flex-col items-center justify-center text-center">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-xs text-zinc-400 hover:text-white mb-8 transition-colors"
    >
      <ArrowLeft className="h-4 w-4" />
      <span>Back to Atelier</span>
    </a>

    <div class="inline-flex items-center gap-1.5 rounded-full border border-purple-500/30 bg-purple-500/10 px-3.5 py-1 text-xs text-purple-300 mb-6">
      <Flame className="h-3.5 w-3.5 text-purple-400" />
      <span>Module Phase 3: Viral Aesthetic Engine</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-serif font-bold text-white tracking-tight">
      Aesthetic Architecture & Style Diagnosis
    </h1>

    <p class="mt-4 max-w-xl text-sm sm:text-base text-zinc-400 leading-relaxed font-light">
      Comprehensive facial ratio analysis, personalized haircut simulations, glasses frame recommendations, and grooming blueprints. Built for self-improvement and viral social sharing.
    </p>

    <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 w-full max-w-2xl text-left">
      <div class="glass-panel p-4 rounded-xl border border-white/10">
        <div class="flex items-center gap-1.5 text-xs font-semibold text-white">
          <Check className="h-4 w-4 text-purple-400" />
          <span>Craniofacial Proportions</span>
        </div>
        <p class="text-[11px] text-zinc-400 mt-1">Golden ratio symmetry & jawline angle scan</p>
      </div>

      <div class="glass-panel p-4 rounded-xl border border-white/10">
        <div class="flex items-center gap-1.5 text-xs font-semibold text-white">
          <Check className="h-4 w-4 text-purple-400" />
          <span>Virtual Haircut Try-On</span>
        </div>
        <p class="text-[11px] text-zinc-400 mt-1">Test buzz cuts, pompadours, or bobs instantly</p>
      </div>

      <div class="glass-panel p-4 rounded-xl border border-white/10">
        <div class="flex items-center gap-1.5 text-xs font-semibold text-white">
          <Check className="h-4 w-4 text-purple-400" />
          <span>Eyewear & Frame Match</span>
        </div>
        <p class="text-[11px] text-zinc-400 mt-1">Harmonize frame shapes with your jaw geometry</p>
      </div>
    </div>

    <div class="mt-10 rounded-2xl glass-panel p-6 border border-white/15 w-full max-w-md">
      <h3 class="text-sm font-semibold text-white">
        Join the Priority Waitlist
      </h3>
      <p class="text-xs text-zinc-400 mt-1">
        Be the first to unlock your personalized 12-page aesthetic dossier.
      </p>
      <form class="mt-4 flex gap-2" onsubmit="event.preventDefault(); alert('Priority waitlist spot reserved!');">
        <input
          type="email"
          required
          placeholder="Enter your email"
          class="flex-1 rounded-xl bg-black/60 border border-white/15 px-3.5 py-2 text-xs text-white placeholder:text-zinc-600 outline-none focus:border-purple-400"
        />
        <button
          type="submit"
          class="rounded-xl bg-gradient-to-r from-purple-500 to-indigo-600 px-4 py-2 text-xs font-semibold text-white hover:scale-[1.02] transition-all"
        >
          Join Waitlist
        </button>
      </form>
    </div>
  </div>
</Layout>
